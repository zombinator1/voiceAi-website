---
import { telefonAi } from '../config';
import LeadForm from './LeadForm.astro';
---

<section id="kontakt" class="na-ciemnym sekcja bg-centrala text-arkusz">
  <div class="arkusz-kolumna">
    <div class="lg:grid lg:grid-cols-[7rem_minmax(0,1fr)] lg:gap-x-12">
      <div class="mb-5 flex items-center gap-3 lg:mb-0 lg:block lg:pt-3">
        <span class="maszynowa text-arkusz/55">09</span>
        <span class="block h-px w-8 bg-arkusz/25 lg:mt-3 lg:w-10"></span>
      </div>

      <div>
        <h2 class="text-h2 max-w-[18ch]">Zadzwoń albo zostaw numer</h2>

        <div class="mt-8 grid gap-8 lg:mt-10 lg:grid-cols-2 lg:gap-14">
          <div class="@container">
            <p class="max-w-[46ch] text-arkusz/85">
              Pierwsza droga zajmuje minutę i od razu wiesz, o czym mówię. Druga
              jest dla tych, którzy właśnie pracują i nie mogą teraz rozmawiać.
            </p>

            <div class="group mt-6 block border border-arkusz/30 border-l-4 border-l-sluchawka bg-transparent px-5 py-6 hover:bg-arkusz transition">
              <span class="maszynowa block text-arkusz/60 group-hover:text-notatka">
                numer do mojego asystenta AI
              </span>
              <span
                class="numer-demo mt-3 block font-display font-700 tracking-[-0.015em] tabular-nums text-arkusz group-hover:text-sluchawka"
              >
                {telefonAi}
              </span>
            </div>

            <p class="mt-4 max-w-[44ch] text-meta text-arkusz/70">
              Zadzwoń o dowolnej porze. Jeśli agent poradzi sobie z Twoimi
              pytaniami, poradzi sobie z pytaniami Twoich klientów.
            </p>
          </div>

          <div class="lg:pt-1">
            <LeadForm
              idPrefix="cta"
              zrodlo="cta-koncowe"
              tytul="Zostaw numer, oddzwonię"
              opis="Imię i telefon wystarczą. Oddzwaniam w godzinach pracy — bez skryptu sprzedażowego."
            />
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

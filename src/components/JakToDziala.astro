---
import Sekcja from './Sekcja.astro';

const kroki = [
  {
    numer: '1',
    tytul: 'Rozmawiamy',
    tresc: [
      'Dowiaduje się więcej o Twojej firmie:',
      '- w jakim celu najczęściej dzwonią klienci np: zgłoszenie serwisowe, umówienie wizyty',
      '- jakie najczęściej zadają pytania'
    ],
  },
  {
    numer: '2',
    tytul: 'Budujemy agenta',
    tresc: [
      'Powstaje baza wiedzy, scenariusz rozmowy i automatyzacja (np. wysyłka email z transkryptem rozmowy na Twój adres email). Zanim cokolwiek podłączysz, dzwonisz i słuchasz. Poprawiamy, aż zacznie brzmieć tak, jak sam byś odpowiedział.',
    ],
  },
    {
    numer: '3',
    tytul: 'Formalności',
    tresc: [
      'Podpisujemy umowę powierzenia danych osobowych i o świadczeniu usług.',
      'Dokument przygotował profesjonalista, z kancelarii Creativ Legal.',
      'Na tym etapie proszę o pierwszą wpłate, z góry.'
    ],
  },
  {
    numer: '4',
    tytul: 'Przekierowujesz numer',
    tresc: [
      'Wpisujesz w swoim telefonie kod (np. **61*+48XXXXXXXXX*11*20#). Automat odbiera połączenie po 20s nieaktywności. Poza tym, nie musisz nic zmieniać w swojej konfiguracji.' 
    ],
  },
];
---

<Sekcja numer="03" id="jak-to-dziala" tytul="Dwu tygodniowy proces">
  <ol class="max-w-[64ch]">
    {
      kroki.map((k, i) => (
        <li
          class:list={[
            'grid gap-x-6 gap-y-3 py-7 sm:grid-cols-[3.5rem_minmax(0,1fr)] sm:py-9',
            i > 0 ? 'border-t border-linia' : 'pt-0',
          ]}
        >
          <span
            class="font-display text-[2.25rem] font-700 leading-none tabular-nums text-notatka/80 sm:text-[3rem]"
            aria-hidden="true"
          >
            {k.numer}
          </span>
          <div>
            <h3 class="text-h3">{k.tytul}</h3>
            <div class="mt-3 space-y-3 text-centrala-80">
              {k.tresc.map((p) => (
                <p>{p}</p>
              ))}
            </div>
          </div>
        </li>
      ))
    }
  </ol>
</Sekcja>

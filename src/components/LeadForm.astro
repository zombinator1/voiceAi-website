---
/* Czysty <form> w .astro — bez wyspy, bez frameworka.
   Wysyłka leci natywnym POST-em do funkcji /api/kontakt, która dopiero
   po stronie serwera woła Lettermint (token nie może trafić do przeglądarki).
   Działa bez JavaScriptu. */
interface Props {
  /** Prefiks id — na stronie są dwa formularze, etykiety muszą trafić we właściwe pole. */
  idPrefix: string;
  /** Trafia do zgłoszenia jako ukryte pole — wiadomo, z której sekcji przyszło. */
  zrodlo: string;
  tytul: string;
  opis: string;
}

const { idPrefix, zrodlo, tytul, opis } = Astro.props;

const pole =
  'mt-1.5 block w-full min-h-11 border border-linia bg-arkusz px-3.5 py-2.5 text-body text-centrala placeholder:text-notatka focus:border-centrala focus:outline-none';
const etykieta = 'maszynowa text-notatka';
---

{/* `na-jasnym` przywraca ciemny kolor tekstu i obrysu focusu,
    kiedy kartka leży w ciemnej sekcji */}
<div class="na-jasnym border border-linia bg-arkusz p-5 text-centrala sm:p-7">
  <h3 class="text-h3">{tytul}</h3>
  <p class="mt-2 text-meta text-centrala-80">{opis}</p>

  <form name="kontakt" method="POST" action="/api/kontakt" class="mt-6 space-y-5">
    <input type="hidden" name="zrodlo" value={zrodlo} />

    {/* pułapka na boty — ukryta przed ludźmi, widoczna dla skryptów */}
    <p class="hidden" aria-hidden="true">
      <label>
        Nie wypełniaj tego pola: <input name="bot-field" tabindex="-1" autocomplete="off" />
      </label>
    </p>

    <div>
      <label class={etykieta} for={`${idPrefix}-imie`}>Imię</label>
      <input
        class={pole}
        id={`${idPrefix}-imie`}
        name="imie"
        type="text"
        required
        autocomplete="given-name"
        placeholder="Jak się do Ciebie zwracać"
      />
    </div>

    <div>
      <label class={etykieta} for={`${idPrefix}-telefon`}>Telefon</label>
      <input
        class={pole}
        id={`${idPrefix}-telefon`}
        name="telefon"
        type="tel"
        required
        inputmode="tel"
        autocomplete="tel"
        placeholder="Numer, pod który mam oddzwonić"
      />
    </div>

    <div>
      <label class={etykieta} for={`${idPrefix}-wiadomosc`}>
        Wiadomość <span class="normal-case tracking-normal">(opcjonalnie)</span>
      </label>
      <textarea
        class={`${pole.replace('min-h-11', 'min-h-24')} resize-y`}
        id={`${idPrefix}-wiadomosc`}
        name="wiadomosc"
        rows="3"
        maxlength="2000"
        placeholder="W czym mogę pomóc? Możesz zostawić puste."></textarea>
    </div>

    <div class="flex items-start gap-3">
      <input
        class="mt-px size-6 shrink-0 accent-sluchawka"
        id={`${idPrefix}-zgoda`}
        name="zgoda"
        type="checkbox"
        required
        value="tak"
      />
      <label class="text-meta text-centrala-80" for={`${idPrefix}-zgoda`}>
        Zgadzam się na kontakt telefoniczny i przetwarzanie moich danych w celu
        odpowiedzi na to zgłoszenie. Zasady opisuje{' '}
        <a
          class="text-centrala underline underline-offset-2 hover:text-sluchawka"
          href="/rodo">polityka prywatności</a
        >.
      </label>
    </div>

    <button
      class="min-h-12 w-full bg-sluchawka px-6 py-3 font-display text-base font-600 tracking-[-0.01em] text-arkusz hover:bg-sluchawka-ciemna"
      type="submit"
    >
      Oddzwońcie do mnie
    </button>
  </form>
</div>

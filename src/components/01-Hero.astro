---
import { telefonAi, telefonAiHref, TRANSKRYPT } from '../config';
import ZywaRozmowa from './ZywaRozmowa.astro';

/* Przebieg ilustracyjny — pokazuje, CO robi agent, nie udaje realnej rozmowy.
   Gdy w configu pojawi się prawdziwy TRANSKRYPT, zastępuje ten przykład. */
const przykladowyPrzebieg = [
  { mowca: 'agent', tekst: 'Dzień dobry, w czym mogę pomóc?' },
  { mowca: 'dzwoniacy', tekst: 'Chciałbym zlecić podłączenie i ustawienie miękkości/twardości wody.' },
  { mowca: 'agent', tekst: 'Oczywiście. Pod jaki adres mamy przyjechać?' },
  { mowca: 'dzwoniacy', tekst: 'Kwiatowa 12, Kraków.' },
  { mowca: 'agent', tekst: 'Jaki to model urządzenia?' },
  { mowca: 'dzwoniacy', tekst: 'WATER TECHNIC 123' },
  { mowca: 'agent', tekst: 'Dziękuję. Zgłoszenie przekazuję od razu, a na koniec wyślę podsumowanie, żeby nic nie umknęło.' },
] as const;

const przebiegRozmowy = TRANSKRYPT.length > 0 ? TRANSKRYPT.slice(0, 6) : przykladowyPrzebieg;
const etykietaRozmowy =
  TRANSKRYPT.length > 0 ? 'fragment rozmowy z dema' : 'przykładowy przebieg rozmowy';
---

<section class="relative overflow-hidden border-b border-linia">
  {/* światło na papierze: lewa góra jaśniejsza, nic więcej */}
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 bg-[radial-gradient(70%_60%_at_18%_0%,rgb(255_255_255/0.65),transparent_70%)]"
  >
  </div>

  <div
    class="arkusz-kolumna relative grid gap-12 py-12 sm:py-16 lg:grid-cols-[minmax(0,1.08fr)_minmax(26rem,0.92fr)] lg:items-center lg:gap-16 lg:py-20"
  >
    <div class="max-w-[44rem]">
      <p class="maszynowa flex items-center gap-3 text-notatka">
        <span class="inline-block size-1.5 rounded-full bg-nieodebrane"></span>
        01 — telefon bez odpowiedzi to utracony klient
      </p>

      <h1 class="mt-6 text-h1 max-w-[18ch] sm:mt-7">
        Chcesz aby <em class="italic">każde</em> połączenie zostało odebrane?
      </h1>

      <p class="mt-7 max-w-[46ch] text-lead text-centrala-80">
        Asystent AI odbiera połączenia, zbiera zgłoszenie i wysyła Ci gotowe
        podsumowanie — gdy jesteś u klienta, po godzinach albo masz zajętą linię.
      </p>

      <div class="mt-10 sm:mt-12">
        <a
          href={`tel:${telefonAiHref}`}
          class="group flex w-full max-w-[30rem] items-center justify-between gap-6 rounded-[3px] bg-sluchawka px-6 py-5 text-arkusz shadow-kartka transition hover:bg-sluchawka-ciemna"
        >
          <span class="flex flex-col gap-1.5">
            <span class="maszynowa text-[0.6875rem] text-arkusz/70">
              Umów się poprzez mojego asystenta AI
            </span>
            <span class="font-mono text-xl font-500 tracking-[0.02em] tabular-nums sm:text-2xl">
              {telefonAi}
            </span>
          </span>
          <span
            aria-hidden="true"
            class="flex size-10 shrink-0 items-center justify-center rounded-full border border-arkusz/30 transition group-hover:translate-x-0.5 group-hover:border-arkusz/60"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 12h14" /><path d="m13 6 6 6-6 6" />
            </svg>
          </span>
        </a>

        <p class="mt-5 flex flex-wrap items-center gap-x-5 gap-y-2 text-meta text-centrala-80">
          <span class="maszynowa text-notatka">bez zmiany numeru · zgodne z rodo</span>
          <a
            class="font-500 text-centrala underline decoration-linia-mocna underline-offset-4 transition hover:decoration-centrala"
            href="#kontakt">Wolisz napisać? Zostaw numer, oddzwonię.</a
          >
        </p>
      </div>
    </div>

    <ZywaRozmowa linie={przebiegRozmowy} etykieta={etykietaRozmowy} />
  </div>
</section>

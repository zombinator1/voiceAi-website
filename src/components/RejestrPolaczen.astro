---
import { telefonAi, telefonAiHref } from '../config';

/* Wykaz ilustracyjny — depikcja pojęcia „nieodebrany telefon”, nie zapis
   czyichkolwiek połączeń. Numery są zamaskowane, dat brak celowo. */
const nieodebrane = [
  { godzina: '08:42', numer: '+48 ••• ••• 214' },
  { godzina: '11:07', numer: '+48 ••• ••• 880' },
  { godzina: '13:55', numer: '+48 ••• ••• 137' },
  { godzina: '16:21', numer: '+48 ••• ••• 069' },
  { godzina: '18:30', numer: '+48 ••• ••• 402' },
  { godzina: '21:14', numer: '+48 ••• ••• 651' },
];
---

<div class="@container">
<div class="border border-linia bg-arkusz-glebszy">
  <table class="w-full border-collapse text-left">
    <caption
      class="maszynowa border-b border-linia px-4 py-3 text-left text-notatka sm:px-5"
    >
      Jeden dzień w firmie{' '}
      <span class="sr-only">— wykaz ilustracyjny, nie zapis rzeczywistych połączeń</span>
    </caption>

    <thead class="sr-only">
      <tr>
        <th scope="col">Godzina</th>
        <th scope="col">Numer</th>
        <th scope="col">Status</th>
        <th scope="col">Czas rozmowy</th>
      </tr>
    </thead>

    <tbody class="font-mono text-[0.8125rem] sm:text-sm">
      {
        nieodebrane.map((w) => (
          <tr class="border-b border-linia/70 last:border-b-0">
            <td class="py-2.5 pl-4 pr-3 tabular-nums text-notatka sm:pl-5">{w.godzina}</td>
            <td class="hidden py-2.5 pr-3 tabular-nums xs:table-cell">{w.numer}</td>
            {/* status niesie słowo, nie sam kolor — czerwony i zielony to
                najgorsza możliwa para przy daltonizmie */}
            <td class="py-2.5 pr-3 text-nieodebrane">nieodebrane</td>
            <td class="py-2.5 pr-4 text-right tabular-nums text-notatka sm:pr-5">0:00</td>
          </tr>
        ))
      }
    </tbody>
  </table>
</div>

{/* Rozwiązanie: ta sama szerokość, ta sama typografia maszynowa — ciąg
    dalszy tego samego wykazu, tyle że wiersz jest odebrany. */}
<a
  href={`tel:${telefonAiHref}`}
  class="group mt-3 block border border-sluchawka border-l-4 bg-arkusz px-4 py-5 hover:bg-sluchawka focus-visible:bg-sluchawka sm:px-5 sm:py-6"
  aria-label={`Zadzwoń pod numer demo ${telefonAi}`}
>
  <span
    class="maszynowa flex items-center justify-between gap-3 text-sluchawka group-hover:text-arkusz group-focus-visible:text-arkusz"
  >
    <span>odebrane · agent</span>
    <span class="tabular-nums normal-case tracking-normal">0:47</span>
  </span>

  <span
    class="numer-demo mt-3 block font-display font-700 tracking-[-0.015em] text-sluchawka tabular-nums group-hover:text-arkusz group-focus-visible:text-arkusz"
  >
    {telefonAi}
  </span>

  <span
    class="mt-3 block text-meta text-centrala-80 group-hover:text-arkusz/85 group-focus-visible:text-arkusz/85"
  >
    Zainteresowany? Wątpisz, że to działa? Zadzwoń do mojego agenta.
  </span>
</a>
</div>

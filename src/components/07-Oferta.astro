---
import Sekcja from './Sekcja.astro';

const standard = [
  ['opłata wdrożeniowa', 'brak'],
  // ["w abonamencie", "300 minut rozmów — około 100 telefonów"],
  // ["powyżej limitu", "1,50 zł za minutę"],
  [
    'po każdej rozmowie',
    'podsumowanie na Twoją skrzynkę albo umówione sotkanie w kalendarzu, klient dostaje SMS',
  ],
  ['automatyzacje', 'Dostosowane do Twoich potrzeb'],
  ['baza wiedzy', 'aktualizowana, kiedy zmienią się ceny albo godziny'],
];
---

<Sekcja numer="05" id="oferta" tytul="Bez opłaty za wdrożenie">
  {/* pasek programu pilotażowego */}
  <div class="rounded-[3px] border border-linia bg-arkusz-jasny p-5 shadow-kartka sm:p-6">
    <p class="maszynowa flex items-center gap-2.5 text-sluchawka">
      <span class="inline-block size-1.5 rounded-full bg-sluchawka"></span>
      Program pilotażowy
    </p>
    <p class="mt-3 max-w-[62ch] text-centrala-80">
      Preferencyjna oferta dla pierwszych klientów - bez opłaty za wdrożenie. W zamian proszę o
      dwie rzeczy: szczerą opinię i zgodę na opisanie efektów, kiedy już będą.
    </p>
  </div>

  {/* Standard — jedyny plan, więc jest kartą, nie kolumną w tabeli */}
  <div class="mt-6 overflow-hidden rounded-[3px] border border-centrala/80 bg-arkusz-jasny shadow-scena">
    <div class="flex items-center justify-between gap-4 border-b border-linia px-6 py-4 sm:px-8">
      <p class="maszynowa text-notatka">Standard</p>
      <p class="maszynowa text-notatka">abonament miesięczny</p>
    </div>

    <div class="px-6 py-8 sm:px-8 sm:py-10">
      <p class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
        <span class="font-display text-[clamp(3rem,6vw,4.5rem)] leading-none tracking-[-0.02em] tabular-nums">
          290 zł
        </span>
        <span class="text-lead text-centrala-80">/ miesiąc</span>
      </p>
      <p class="mt-2 text-centrala-80">+ około 60 gr za min</p>

      <dl class="mt-9 border-t border-linia">
        {
          standard.map(([etykieta, wartosc]) => (
            <div class="grid gap-1 border-b border-linia py-4 sm:grid-cols-[11rem_minmax(0,1fr)] sm:gap-6">
              <dt class="maszynowa pt-0.5 text-notatka">{etykieta}</dt>
              <dd class="text-[0.9375rem] leading-snug text-centrala">{wartosc}</dd>
            </div>
          ))
        }
      </dl>
    </div>

    <div class="px-6 pb-8 sm:px-8 sm:pb-10">
      <a
        href="#kontakt"
        class="flex min-h-13 items-center justify-center gap-3 rounded-[3px] bg-sluchawka px-6 py-3 font-sans text-base font-500 text-arkusz shadow-kartka transition hover:bg-sluchawka-ciemna"
      >
        Zajmij miejsce w pilotażu
        <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14" /><path d="m13 6 6 6-6 6" /></svg>
      </a>
    </div>
  </div>
</Sekcja>

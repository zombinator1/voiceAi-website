---
import { telefonAi, telefonAiHref } from '../config';
---

{/* Kciuk sięga dołu ekranu, nie góry — na mobile numer mieszka tutaj. */}
<a
  href={`tel:${telefonAiHref}`}
  class="na-ciemnym fixed inset-x-0 bottom-0 z-50 flex min-h-[3.5rem] items-center justify-between gap-4 bg-sluchawka px-5 pb-[env(safe-area-inset-bottom)] text-arkusz shadow-[0_-8px_24px_-12px_rgb(15_19_22/0.5)] sm:hidden"
>
  <span class="flex flex-col gap-0.5">
    <span class="maszynowa text-[0.6875rem] text-arkusz/75">zadzwoń do agenta</span>
    <span class="font-mono text-lg font-500 tracking-[0.04em] tabular-nums">{telefonAi}</span>
  </span>
  <span
    aria-hidden="true"
    class="flex size-9 shrink-0 items-center justify-center rounded-full border border-arkusz/35"
  >
    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2" />
    </svg>
  </span>
</a>

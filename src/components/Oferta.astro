---
import Sekcja from "./Sekcja.astro";

const standard = [
  ["opłata wdrożeniowa", "brak"],
  ["w abonamencie", "300 minut rozmów — około 100 telefonów"],
  ["powyżej limitu", "1,50 zł za minutę"],
  ["po każdej rozmowie", "podsumowanie na Twoją skrzynkę, klient dostaje SMS"],
  ["baza wiedzy", "aktualizowana, kiedy zmienią się ceny albo godziny"],
];

const indywidualna = [
  [
    "dla kogo",
    "większy ruch, kilka numerów, integracja z CRM albo kalendarzem",
  ],
  ["zakres", "ustalany pod firmę"],
  ["czas reakcji", "ustalany w umowie"],
  ["cena", "po rozmowie o tym, co ma robić agent"],
];
---

<Sekcja numer="05" id="oferta" tytul="Ile to kosztuje">
  {/* pasek programu pilotażowego */}
  <div class="border-l-4 border-sluchawka bg-arkusz-glebszy p-5 sm:p-6">
    <p class="maszynowa text-sluchawka">Program pilotażowy — 5 miejsc</p>
    <p class="mt-3 max-w-[62ch] text-centrala-80">
      Startuję i szukam pierwszych klientów. W zamian za warunki poniżej proszę
      o dwie rzeczy: szczerą opinię — także tę niewygodną — i zgodę na opisanie
      efektów, kiedy już będą. Po piątym wdrożeniu warunki dla kolejnych
      klientów się zmienią.
    </p>
  </div>

  <div class="mt-8 grid gap-6 lg:grid-cols-2 lg:gap-8">
    {/* Standard — wyróżniony */}
    <div class="flex flex-col border-2 border-centrala bg-arkusz">
      <div class="border-b border-linia px-5 py-4 sm:px-7">
        <p class="maszynowa text-notatka">Standard</p>
      </div>

      <div class="px-5 py-6 sm:px-7">
        <p class="flex flex-wrap items-baseline gap-x-2.5">
          <span
            class="font-display text-[2.75rem] font-700 leading-none tracking-[-0.02em] tabular-nums sm:text-[3.25rem]"
          >
            490 zł
          </span>
          <span class="text-centrala-80">/ miesiąc</span>
        </p>

        <dl class="mt-7 space-y-4">
          {
            standard.map(([etykieta, wartosc]) => (
              <div class="grid gap-0.5 border-t border-linia pt-3.5 sm:grid-cols-[10.5rem_minmax(0,1fr)] sm:gap-4">
                <dt class="maszynowa pt-0.5 text-notatka">{etykieta}</dt>
                <dd class="text-[0.9375rem] leading-snug">{wartosc}</dd>
              </div>
            ))
          }
        </dl>
      </div>

      <div class="mt-auto px-5 pb-6 sm:px-7">
        <a
          href="#kontakt"
          class="flex min-h-12 items-center justify-center bg-sluchawka px-6 py-3 font-display text-base font-600 text-arkusz hover:bg-sluchawka-ciemna"
        >
          Zajmij miejsce w pilotażu
        </a>
      </div>
    </div>

    {/* Wycena indywidualna */}
    <div class="flex flex-col border border-linia bg-arkusz">
      <div class="border-b border-linia px-5 py-4 sm:px-7">
        <p class="maszynowa text-notatka">Wycena indywidualna</p>
      </div>

      <div class="px-5 py-6 sm:px-7">
        <p
          class="font-display text-[2rem] font-700 leading-none tracking-[-0.02em] text-centrala-80 sm:text-[2.25rem]"
        >
          Zależy, co ma robić
        </p>

        <dl class="mt-7 space-y-4">
          {
            indywidualna.map(([etykieta, wartosc]) => (
              <div class="grid gap-0.5 border-t border-linia pt-3.5 sm:grid-cols-[10.5rem_minmax(0,1fr)] sm:gap-4">
                <dt class="maszynowa pt-0.5 text-notatka">{etykieta}</dt>
                <dd class="text-[0.9375rem] leading-snug">{wartosc}</dd>
              </div>
            ))
          }
        </dl>
      </div>

      <div class="mt-auto px-5 pb-6 sm:px-7">
        <a
          href="#kontakt"
          class="flex min-h-12 items-center justify-center border border-centrala px-6 py-3 font-display text-base font-600 text-centrala hover:bg-centrala hover:text-arkusz"
        >
          Opisz swój przypadek
        </a>
      </div>
    </div>
  </div>
</Sekcja>

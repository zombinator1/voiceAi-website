---
import Sekcja from './Sekcja.astro';

const punkty = [
  {
    znacznik: '§ 1',
    tytul: '30 dni na zwrot pieniędzy, bez pytań',
    tresc:
      'Jeśli w ciągu pierwszych trzydziestu dni uznasz, że u Ciebie to nie działa, oddaję pieniądze. Nie pytam o powód i nie próbuję Cię zatrzymać rozmową. To ja wchodzę na ten rynek bez dorobku, więc to ja biorę na siebie ryzyko próby.',
  },
  {
    znacznik: '§ 2',
    tytul: 'Bez długich umów',
    tresc:
      'Minimum to trzy miesiące — tyle trzeba, żeby w ogóle było co oceniać, bo w pierwszych tygodniach agent się dociera do Twoich pytań. Potem wypowiadasz w dowolnym momencie. Bez okresów wypowiedzenia liczonych w kwartałach i bez kar za rezygnację.',
  },
  {
    znacznik: '§ 3',
    tytul: 'Bez zmiany operatora i bez wymiany sprzętu',
    tresc:
      'Zostajesz przy swoim numerze, swoim operatorze i swoich telefonach. Nie kupujesz centrali i nie podpisujesz nowej umowy z operatorem. Całą zmianą po Twojej stronie jest jedno przekierowanie — odwracalne w minutę.',
  },
  {
    znacznik: '§ 4',
    tytul: 'Zgodność z RODO i umowa powierzenia',
    tresc:
      'Dane z rozmów przetwarzamy zgodnie z przepisami, na podstawie umowy powierzenia przetwarzania danych, którą podpisujemy przed uruchomieniem agenta. Wiesz, jakie dane są zbierane, gdzie trafiają i jak długo są przechowywane.',
  },
  {
    znacznik: '§ 5',
    tytul: 'Dzwoniący wie, z kim rozmawia',
    tresc:
      'Agent na początku rozmowy mówi, że jest asystentem. Nie udaje człowieka i nie ma udawać. Klient, który w połowie rozmowy orientuje się, że został wprowadzony w błąd, to gorszy wynik niż nieodebrany telefon.',
  },
];
---

<Sekcja numer="06" id="bez-ryzyka" tytul="Co bierzemy na siebie">
  <p class="max-w-[58ch]">
    Kupujesz od firmy, która nie ma jeszcze historii. Poniższe pięć punktów jest po
    to, żebyś nie musiał w nią wierzyć na słowo.
  </p>

  <dl class="mt-8 max-w-[64ch] sm:mt-10">
    {
      punkty.map((p) => (
        <div class="grid gap-x-8 gap-y-2 border-t border-linia py-6 sm:grid-cols-[4rem_minmax(0,1fr)] sm:py-7">
          <span class="maszynowa pt-1 tabular-nums text-notatka" aria-hidden="true">
            {p.znacznik}
          </span>
          <div>
            <dt class="font-display text-[1.0625rem] font-600 leading-snug tracking-[-0.01em]">
              {p.tytul}
            </dt>
            <dd class="mt-2 text-centrala-80">{p.tresc}</dd>
          </div>
        </div>
      ))
    }
  </dl>
</Sekcja>

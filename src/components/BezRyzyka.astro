---
import Sekcja from './Sekcja.astro';

const punkty = [
  {
    znacznik: '§ 1',
    tytul: 'Stale dbam o działanie systemu',
    tresc:
      'Nadzoruje prawidłowe działanie, a umowę możesz wypowiedzieć w każdej chwili.',
  },
  {
    znacznik: '§ 2',
    tytul: 'Bez zmiany operatora i bez wymiany sprzętu',
    tresc:
      'Zostajesz przy swoim numerze, swoim operatorze i swoich telefonach. Całą zmianą po Twojej stronie jest jedno przekierowanie — odwracalne w minutę.',
  },
  {
    znacznik: '§ 3',
    tytul: 'Zgodność z RODO i umowa powierzenia',
    tresc:
      'Dane z rozmów przetwarzamy zgodnie z przepisami, na podstawie umowy powierzenia przetwarzania danych, którą podpisujemy przed uruchomieniem agenta. Automat spełnia wymogi RODO i AI act. Pomaga mi kancelaria Creativ Legal.',
  }
];
---

<Sekcja numer="06" id="bez-ryzyka" tytul="Gwarancja satysfakcji">

  <dl class="mt-8 max-w-[64ch] sm:mt-10">
    {
      punkty.map((p) => (
        <div class="grid gap-x-8 gap-y-2 border-t border-linia py-6 sm:grid-cols-[4rem_minmax(0,1fr)] sm:py-7">
          <span class="maszynowa pt-1 tabular-nums text-notatka" aria-hidden="true">
            {p.znacznik}
          </span>
          <div>
            <dt class="font-display text-[1.0625rem] font-600 leading-snug tracking-[-0.01em]">
              {p.tytul}
            </dt>
            <dd class="mt-2 text-centrala-80">{p.tresc}</dd>
          </div>
        </div>
      ))
    }
  </dl>
</Sekcja>

---
import { FIRMA } from '../config';
---

<header class="sticky top-0 z-50 border-b border-linia/80 bg-arkusz/85 backdrop-blur-md">
  <div class="arkusz-kolumna flex h-14 items-center justify-between gap-4 sm:h-16">
    <a
      href="/"
      class="flex min-h-11 items-center font-sans text-[0.9375rem] font-600 tracking-[-0.01em] text-centrala sm:text-base"
    >
      {FIRMA.nazwa}
    </a>

    <nav class="flex items-center gap-1 sm:gap-3" aria-label="Sekcje strony">
      <a
        href="#przyklady"
        class="hidden min-h-11 items-center px-2 text-[0.9375rem] text-centrala-80 transition hover:text-centrala md:flex"
      >
        <span class="lg:hidden">Posłuchaj rozmowy</span>
        <span class="hidden lg:inline">Posłuchaj, jak agent prowadzi rozmowę</span>
      </a>
      <a
        href="#jak-to-dziala"
        class="hidden min-h-11 items-center px-2 text-[0.9375rem] text-centrala-80 transition hover:text-centrala md:flex"
      >
        Wdrożenie
      </a>
      <a
        href="#oferta"
        class="hidden min-h-11 items-center px-2 text-[0.9375rem] text-centrala-80 transition hover:text-centrala sm:flex"
      >
        Cennik
      </a>
      <a
        href="#kontakt"
        class="ml-1 inline-flex min-h-10 items-center rounded-[3px] bg-centrala px-4 text-[0.9375rem] font-500 text-arkusz transition hover:bg-noc"
      >
        Kontakt
      </a>
    </nav>
  </div>
</header>

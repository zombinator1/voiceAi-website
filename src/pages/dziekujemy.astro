---
import Base from '../layouts/Base.astro';
import { telefonAi, telefonAiHref, FIRMA } from '../config';
---

<Base
  tytul={`Dziękuję — ${FIRMA.nazwa}`}
  opis="Zgłoszenie przyjęte. Oddzwonię."
  pasekMobilny={false}
>
  <section class="sekcja">
    <div class="arkusz-kolumna">
      <div class="@container max-w-[52ch]">
        <p class="maszynowa text-sluchawka">zgłoszenie przyjęte</p>

        <h1 class="text-h1 mt-4">Mam Twój numer. Oddzwonię.</h1>

        <p class="mt-6 text-lead text-centrala-80">
          Odzywam się w godzinach pracy. Jeśli nie chcesz czekać, agent odbiera
          od razu — o dowolnej porze.
        </p>

        <a
          href={`tel:${telefonAiHref}`}
          class="group mt-8 block rounded-[3px] border border-linia bg-arkusz-jasny px-6 py-7 shadow-kartka transition hover:border-sluchawka"
        >
          <span class="maszynowa flex items-center gap-2.5 text-sluchawka">
            <span class="inline-block size-1.5 rounded-full bg-sluchawka"></span>
            numer demo
          </span>
          <span
            class="numer-demo mt-3 block font-display tracking-[-0.02em] tabular-nums text-centrala transition group-hover:text-sluchawka"
          >
            {telefonAi}
          </span>
        </a>

        <a
          href="/"
          class="maszynowa mt-8 inline-flex min-h-11 items-center text-notatka hover:text-centrala"
        >
          ← powrót na stronę główną
        </a>
      </div>
    </div>
  </section>
</Base>

---
import Base from '../layouts/Base.astro';
import { FIRMA } from '../config';
---

<Base
  tytul={`Polityka prywatności — ${FIRMA.nazwa}`}
  opis="Zasady przetwarzania danych osobowych."
  pasekMobilny={false}
>
  <article class="sekcja">
    <div class="arkusz-kolumna">
      <div class="max-w-[68ch]">
        <a
          href="/"
          class="maszynowa inline-flex min-h-11 items-center text-notatka hover:text-centrala"
        >
          ← powrót na stronę główną
        </a>

        <h1 class="text-h1 mt-6">Polityka prywatności</h1>

        <p class="maszynowa mt-4 text-notatka">{FIRMA.nazwa} · NIP {FIRMA.nip}</p>

        {/* Treść dostarcza prawnik — layout i typografia czekają gotowe. */}
        <div class="tresc-polityki mt-10 border-t border-linia pt-10">
          <div class="border border-dashed border-notatka bg-arkusz-glebszy p-6 sm:p-8">
            <p class="font-mono text-[0.9375rem] leading-relaxed text-centrala-80">
              {'{{TREŚĆ POLITYKI PRYWATNOŚCI — DO UZUPEŁNIENIA PRZEZ PRAWNIKA}}'}
            </p>
            <p class="mt-4 text-meta text-notatka">
              Wklej treść w miejsce tego bloku, wewnątrz kontenera{' '}
              <code class="font-mono">.tresc-polityki</code>. Nagłówki{' '}
              <code class="font-mono">h2</code>/<code class="font-mono">h3</code>,
              akapity, listy i linki są już ostylowane pod resztę strony — nie
              trzeba dodawać klas.
            </p>
          </div>
        </div>

        <p class="mt-10 border-t border-linia pt-6 text-meta text-centrala-80">
          Masz pytanie o swoje dane? Napisz na{' '}
          <a class="text-centrala underline underline-offset-2" href={`mailto:${FIRMA.email}`}>
            {FIRMA.email}
          </a>.
        </p>
      </div>
    </div>
  </article>
</Base>

<style>
  /* Typografia treści prawnej — dopasowana do reszty strony,
     działa na czystym HTML wklejonym przez prawnika. */
  .tresc-polityki :global(h2) {
    font-family: var(--font-display);
    font-size: var(--text-h3);
    font-weight: 700;
    letter-spacing: -0.01em;
    margin-block: 2.5rem 0.875rem;
  }
  .tresc-polityki :global(h2:first-child) {
    margin-top: 0;
  }
  .tresc-polityki :global(h3) {
    font-family: var(--font-display);
    font-size: 1.0625rem;
    font-weight: 600;
    margin-block: 1.75rem 0.625rem;
  }
  .tresc-polityki :global(p) {
    margin-block: 0.875rem;
    color: var(--color-centrala-80);
  }
  .tresc-polityki :global(ul),
  .tresc-polityki :global(ol) {
    margin-block: 0.875rem;
    padding-left: 1.375rem;
    color: var(--color-centrala-80);
  }
  .tresc-polityki :global(ul) {
    list-style: disc;
  }
  .tresc-polityki :global(ol) {
    list-style: decimal;
  }
  .tresc-polityki :global(li) {
    margin-block: 0.375rem;
  }
  .tresc-polityki :global(a) {
    color: var(--color-centrala);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .tresc-polityki :global(table) {
    width: 100%;
    margin-block: 1.25rem;
    border-collapse: collapse;
    font-size: 0.9375rem;
    display: block;
    overflow-x: auto;
  }
  .tresc-polityki :global(th),
  .tresc-polityki :global(td) {
    border: 1px solid var(--color-linia);
    padding: 0.625rem 0.75rem;
    text-align: left;
    vertical-align: top;
  }
</style>
